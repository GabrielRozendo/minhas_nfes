# =============================================================================
# Obrigatório para emitir / consultar de verdade
# =============================================================================
CERT_PASSWORD=                 # senha do .pfx
CODIGO_MUNICIPIO=3550308       # IBGE 7 dígitos do município do prestador
CPFCNPJ_PRESTADOR=             # CPF ou CNPJ do prestador (só dígitos)

# Recomendado (templates usam IM do prestador se preenchida)
INSCRICAO_MUNICIPAL=

# =============================================================================
# Já vem com default seguro — só mude se souber o que está fazendo
# =============================================================================
NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/nfse.db
FILES_PATH=/files
CERT_PATH=/certs/certificado.pfx
NFSE_AMBIENTE=homologacao      # mude para producao só depois de testar
DPS_SERIE=1
VER_APLIC=minhas-nfes/0.1.0
PDF_TRY_OFFICIAL=false

# Auth — deixe false em LAN fechada; true se o domínio for acessível
AUTH_ENABLED=false
AUTH_PASSWORD=
API_KEY=
SESSION_SECRET=

# Salvaguardas gov.br (defaults ok)
ADN_SYNC_MIN_INTERVAL_MS=3600000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=1800000
