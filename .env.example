# App
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/nfse.db
# XML + PDF em disco (montar no Docker / fileserver)
FILES_PATH=./files
# Tenta PDF oficial SEFIN antes do DANFSe local (API costuma estar suspensa)
PDF_TRY_OFFICIAL=false

# Auth opcional (dashboard + API)
AUTH_ENABLED=false
AUTH_PASSWORD=troque-esta-senha
API_KEY=troque-esta-api-key
SESSION_SECRET=troque-este-segredo-longo

# Certificado A1 (nunca commitar o .pfx)
CERT_PATH=./certs/certificado.pfx
CERT_PASSWORD=

# NFS-e Nacional — comece SEMPRE em homologacao
NFSE_AMBIENTE=homologacao
CODIGO_MUNICIPIO=3550308
CPFCNPJ_PRESTADOR=
INSCRICAO_MUNICIPAL=
DPS_SERIE=1
VER_APLIC=minhas-nfes/0.1.0

# Salvaguardas gov.br
# Intervalo mínimo após "nenhum documento novo" no ADN (default 1h)
ADN_SYNC_MIN_INTERVAL_MS=3600000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=1800000
